# ── Database ───────────────────────────────────────────────────────────────────
# Passed to the PrismaBetterSqlite3 adapter. Prisma's CLI reads .env, not .env.local,
# so keep DATABASE_URL in .env as well.
DATABASE_URL="file:./dev.db"

# ── Primary model: Gemini (https://aistudio.google.com/apikey) ──────────────────
# The Vercel AI SDK reads this variable by name. Without it every call fails over to the
# fallback model below, which works but is slower.
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-key"

# ── Fallback model: NVIDIA build (https://build.nvidia.com) ─────────────────────
# Used automatically when Gemini is rate-limited, overloaded, or has no valid key.
# Also the only model that reads documents dropped in the inbox (as text). Without it the
# inbox falls back to reading the dates in the text.
NVIDIA_API_KEY="nvapi-your-key"
# NVIDIA retires models without notice (the old default returned 410 Gone). Check
# https://build.nvidia.com for what is currently served and override here if needed.
# NVIDIA_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"

# ── Privacy Vault ──────────────────────────────────────────────────────────────
# true  = health analysis runs on a LOCAL model (Ollama) and never falls back to the cloud.
# false = cloud mode. This is only the default: once toggled in the app, the stored setting wins.
PRIVACY_VAULT_ENABLED="false"
# OLLAMA_BASE_URL="http://localhost:11434/v1"
# OLLAMA_MODEL="deepseek-r1:8b"

# ── Demo mode ──────────────────────────────────────────────────────────────────
# true = no model calls at all. Everything is still computed from the seeded database by the
# deterministic layer (load model, ranking, conflicts, school briefs, built-in meal plan).
NEXT_PUBLIC_DEMO_MODE="false"
